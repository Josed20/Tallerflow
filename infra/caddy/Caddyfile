{
	auto_https off
	admin off

	# Requests reach Caddy through the Docker host or a local tunnel
	# (cloudflared). Trust their forwarded client IP so the backend rate limits
	# per visitor instead of per Docker gateway address.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

http://admin.tallerflowpe.com {
	encode zstd gzip

	handle /api/v1/console/* {
		reverse_proxy backend:8080
	}

	handle /api/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag noindex
		-Server
	}
}

:80 {
	encode zstd gzip

	handle /consola* {
		respond 404
	}

	handle /api/v1/console/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /health/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
